# PYROSENSE frontend — environment template.
# Copy to frontend/.env.local for local dev. In production (Vercel) set these
# in Project → Settings → Environment Variables.

# ── Backend API base URL ─────────────────────────────────────────────────
# [REQUIRED in production] Absolute URL of the deployed backend (Render).
#
# IMPORTANT: NEXT_PUBLIC_* vars are inlined into the client JS bundle at
# BUILD time. Changing the value in the Vercel dashboard does nothing until
# you REDEPLOY. A build without this var falls back to http://localhost:4000,
# which is unreachable for every visitor — since the loud-fail guard was
# added to frontend/lib/api.ts, the app then throws immediately with a clear
# console error instead of failing silently.
#
# Production example (Render web service URL):
NEXT_PUBLIC_API_BASE_URL=https://pyrosense-2aif.onrender.com
#
# Local dev (uncomment or use .env.local):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
