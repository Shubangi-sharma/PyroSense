# PyroSense ML service — environment template.
# Copy to .env and fill in real values.

# ── HTTP ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── PostgreSQL (ML store: predictions, timelines, explanations, hotspots) ───
DATABASE_URL=postgresql+asyncpg://pyrosense:pyrosense@localhost:5432/pyrosense_ml

# ── Existing SQLite (read-only; the Node.js backend's DB) ───────────────────
SQLITE_PATH=../backend/data/terra-watch.db

# ── Model ───────────────────────────────────────────────────────────────────
MODEL_PATH=../FINAL_GRADIENT_BOOSTING_MODEL.pkl

# ── GenAI (OpenRouter — same key as the Node.js backend) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free

# ── FIRMS (only when ENABLE_LIVE_INGEST_SCHEDULER=true) ─────────────────────
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# ── Feature engineering ─────────────────────────────────────────────────────
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WEATHER_LOOKBACK_DAYS=30
DETECTION_RADIUS_KM=1.0

# ── Behaviour ───────────────────────────────────────────────────────────────
SEED_ON_STARTUP=true
ENABLE_LIVE_INGEST_SCHEDULER=false
LIVE_INGEST_INTERVAL_MINUTES=15

# Optional: the original enriched 552-hotspot CSV (36 features + lat/lng).
# When set and present, startup seeding uses it instead of the SQLite fallback.
# PYROSENSE_HISTORICAL_CSV=/path/to/historical_enriched.csv

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.16.*:*
