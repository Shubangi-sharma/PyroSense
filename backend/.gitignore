node_modules/
dist/
# Ignore directory CONTENTS (not the dir itself) so the seed CSV below can
# be re-included — git cannot un-ignore files under an excluded directory.
data/*
# Seed CSV ships in the Docker image (Dockerfile COPYs it) — must be tracked.
# (Untracked, every Render build fails at COPY: pristine clones lack the file.)
!data/user_facilities.csv
*.db
*.db-journal
*.db-wal
*.db-shm
.env
npm-debug.log*
