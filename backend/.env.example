# PYROSENSE backend — environment template.
# Copy to backend/.env for local dev. In production (Render) these are set in
# the service's Environment settings or via render.yaml envVars.
#
# Legend: [REQUIRED] missing = process refuses to start (loud, at boot)
#         [optional] has a working default; missing degrades gracefully

# ── HTTP ─────────────────────────────────────────────────────────────────
# Port the Express server listens on (host 0.0.0.0).
PORT=4000

# ── NASA FIRMS ───────────────────────────────────────────────────────────
# [REQUIRED] NASA FIRMS MAP_KEY (min 16 chars) — https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Missing/short  → zod parse fails, process exits at boot (LOUD).
# INVALID/expired → every fetch returns an empty payload and the ingest jobs
#                   skip it with only a log warn (SILENT — the dashboard shows
#                   zeroes forever). Verify the key with:
#   curl "https://firms.modaps.eosdis.nasa.gov/api/area/csv/<KEY>/VIIRS_SNPP_NRT/68,6,97,37/1"
FIRMS_MAP_KEY=your_firms_map_key_here
# [optional] FIRMS area-CSV endpoint.
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# ── Facility ingestion ───────────────────────────────────────────────────
# [optional] Overpass endpoint used by the facility ingestion job.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ── GenAI (OpenRouter) ───────────────────────────────────────────────────
# [optional] Without a key the AI summary/chat features fall back to
# deterministic templated text (silent feature degradation, nothing crashes).
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free

# ── Database ─────────────────────────────────────────────────────────────
# PATH to the SQLite file (better-sqlite3) — NOT a postgres:// URL.
# Missing       → defaults to ./data/pyrosense.db (relative to backend/).
# Postgres URL  → better-sqlite3 treats it as a weird filename and silently
#                 creates an EMPTY db at a garbage path (SILENT — server runs
#                 fine with 0 rows). This exact bug shipped to prod once.
# Render free plan has NO persistent disks → use /var/data/pyrosense.db and
# accept that data is wiped on every deploy/spin-down; on a paid plan attach
# a disk at /var/data to persist it.
DATABASE_URL=./data/pyrosense.db

# ── pyrosense_ml service ─────────────────────────────────────────────────
# Base URL of the FastAPI ML service (the backend proxies /api/predict and
# /api/ml/* to it). On Render, render.yaml wires this automatically:
#   fromService: { type: web, name: pyrosense-ml, envVarKey: RENDER_EXTERNAL_URL }
# Left unset locally it defaults to http://localhost:5000.
ML_API_BASE_URL=http://localhost:5000

# ── Boot-time archive backfill ────────────────────────────────────
# At boot the backfill runs when EITHER condition holds:
#   - firms_detections has fewer than ARCHIVE_BACKFILL_MIN_ROWS rows, OR
#   - the stored date span is shallower than ARCHIVE_BACKFILL_DAYS minus 1
#     (row count alone is misleading: two live global days already exceed
#     90k rows without any baseline history).
# Then the FIRMS archive is backfilled for ARCHIVE_BACKFILL_DAYS (5-day
# chunks per region, 1.5 s spacing) and matching re-runs. Keeps a free-plan
# deployment (ephemeral disk, wiped on every spin-down) fully useful within
# ~2 minutes of waking. ARCHIVE_BACKFILL_DAYS=0 disables entirely.
ARCHIVE_BACKFILL_DAYS=10
ARCHIVE_BACKFILL_MIN_ROWS=50000

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origin patterns. `*` is a WHOLE-SEGMENT wildcard.
# Exact origin matches must include scheme and port (if non-default).
# Missing → defaults to localhost/LAN patterns only, and every request from
# the deployed frontend fails CORS preflight (SILENT — the browser blocks
# the response; the server logs nothing alarming).
# Production (Render backend + Vercel frontend) example:
#   https://pyro-sense.vercel.app,https://pyro-sense-*.vercel.app
# The second pattern covers Vercel preview-deploy subdomains.
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.16.*:*
